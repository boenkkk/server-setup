# Immich v3 Environment Configuration
# Copy this to .env and customize values as needed

# Server URL for web frontend (change to your domain/IP)
# Not required at runtime (auto-detected), informational only
# VITE_SERVER_URL=http://100.108.83.14:2283

# Immich version tag (use "release" or pin to a version like "v3.2.1")
IMMICH_VERSION=release

# Host port for the Immich web UI + API (2283 = Immich default)
IMMICH_PORT=2283

# Where uploaded media is stored (on the HDD 500 mount)
UPLOAD_LOCATION=/mnt/hdd500/immich

# Where the database files are stored (relative to this compose directory)
DB_DATA_LOCATION=./postgres-data

# Timezone (TZ identifier, e.g. Asia/Jakarta)
TZ=Asia/Jakarta

# Database credentials
# IMPORTANT: DB_PASSWORD must use only A-Za-z0-9 (no special characters)
DB_PASSWORD=postgres
DB_USERNAME=postgres
DB_DATABASE_NAME=immich

# Machine Learning (advanced only — enable with the "ml" profile)
# ML_WORKERS=1