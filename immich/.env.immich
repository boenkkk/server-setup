# Immich Environment Configuration
# Copy this to .env and customize values as needed

# Database Configuration
DB_PASSWORD=immich_secure_password_change_me

# Web Interface Port
IMMICH_WEB_PORT=13000

# API Server Port
IMMICH_PORT=13001

# Server URL for web frontend (change to your domain/IP in production)
VITE_SERVER_URL=http://100.108.83.14:13001

# Log Level: log, debug, warn, error
LOG_LEVEL=log

# Node Environment
NODE_ENV=production

# Machine Learning (optional)
# MACHINE_LEARNING_ENABLED=true
# MACHINE_LEARNING_URL=http://immich-machine-learning:3003

# Optional: Upload directory size limit (in bytes)
# UPLOAD_LOCATION=/usr/src/app/upload

# Optional: Thumbnail cache directory
# THUMB_LOCATION=/usr/src/app/thumbs
