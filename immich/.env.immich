# Immich Environment Configuration
# Copy this to .env and customize values as needed

# Database Configuration
DB_PASSWORD=immich_secure_password_change_me

# Immich Server Port (host)
# Single port serves both web UI and API
# Default: 2283 (3000/3001 taken by Grafana/Uptime-Kuma)
IMMICH_PORT=2283

# Server URL for web frontend (change to your domain/IP in production)
VITE_SERVER_URL=http://100.108.83.14:2283

# Log Level: log, debug, warn, error
LOG_LEVEL=log

# Node Environment
NODE_ENV=production

# Machine Learning (optional — off by default; set to true only if you enable the ml profile)
# MACHINE_LEARNING_ENABLED=true
# MACHINE_LEARNING_URL=http://immich-machine-learning:3003
